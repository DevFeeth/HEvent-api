meta {
  name: Get my upcoming tickets
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users/me/tickets?upcoming=true
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("contains the bought ticket", function () {
    expect(res.body.some(t => t.id === bru.getVar("ticketId"))).to.equal(true);
  });
}
