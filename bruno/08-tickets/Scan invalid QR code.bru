meta {
  name: Scan invalid QR code
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/tickets/scan
  body: json
  auth: bearer
}

auth:bearer {
  token: {{orgaToken}}
}

body:json {
  {
    "qr_token": "not-a-token"
  }
}

tests {
  test("returns 400", function () {
    expect(res.status).to.equal(400);
  });
}
