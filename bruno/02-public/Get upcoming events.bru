meta {
  name: Get upcoming events
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/events/upcoming
  body: none
  auth: none
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("returns 3 published events at most", function () {
    expect(res.body.length).to.be.at.most(3);
    expect(res.body.every(e => e.status === "PUBLISHED")).to.equal(true);
  });
}
