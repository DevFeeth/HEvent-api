meta {
  name: Pay order
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/orders/{{orderId}}/pay
  body: json
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

body:json {
  {
    "payment_method": "pm_card_visa"
  }
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("order is paid", function () {
    expect(res.body.status).to.equal("PAID");
  });
}
