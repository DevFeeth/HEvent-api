meta {
  name: Create promo code
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events/{{eventId}}/promo-codes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{orgaToken}}
}

body:json {
  {
    "code": "{{promoCode}}",
    "discount_type": "PERCENTAGE",
    "discount_value": 20,
    "start_at": "{{promoStart}}",
    "end_at": "{{promoEnd}}",
    "max_uses": 10
  }
}

script:pre-request {
  bru.setVar("promoCode", "BRUNO" + Date.now());
  bru.setVar("promoStart", new Date(Date.now() - 60 * 60 * 1000).toISOString());
  bru.setVar("promoEnd", new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString());
}

script:post-response {
  bru.setVar("promoId", res.body.id);
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}
