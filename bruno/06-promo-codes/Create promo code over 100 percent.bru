meta {
  name: Create promo code over 100 percent
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/events/{{eventId}}/promo-codes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{orgaToken}}
}

body:json {
  {
    "code": "TOOMUCH",
    "discount_type": "PERCENTAGE",
    "discount_value": 150,
    "start_at": "{{promoStart}}",
    "end_at": "{{promoEnd}}"
  }
}

tests {
  test("returns 400", function () {
    expect(res.status).to.equal(400);
  });
}
