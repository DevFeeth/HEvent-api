meta {
  name: Create ticket type
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/events/{{eventId}}/ticket-types
  body: json
  auth: bearer
}

auth:bearer {
  token: {{orgaToken}}
}

body:json {
  {
    "name": "Standard",
    "description": "Standing ticket",
    "price": 25,
    "available_quantity": 4
  }
}

script:post-response {
  bru.setVar("ticketTypeId", res.body.id);
}

tests {
  test("returns 201", function () {
    expect(res.status).to.equal(201);
  });
}
