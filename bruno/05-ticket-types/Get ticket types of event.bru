meta {
  name: Get ticket types of event
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/events/{{eventId}}/ticket-types
  body: none
  auth: none
}

tests {
  test("returns 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("contains the ticket type", function () {
    expect(res.body.some(t => t.id === bru.getVar("ticketTypeId"))).to.equal(true);
  });
}
